# Public, build-time values only. Everything here ends up in the JS bundle and
# can be extracted from a shipped app, so never put a secret in this file.
APP_ENV=staging
API_URL=https://dummyjson.com
CDN_URL=https://cdn.dummyjson.com
SENTRY_DSN=
SOCKET_URL=
# @unit-start:version-gate
# URL of the app config JSON (minimum version, maintenance). Empty turns it off.
APP_CONFIG_URL=
# @unit-end:version-gate
# @unit-start:device-integrity
# On a rooted or jailbroken device: off, warn (once) or block.
DEVICE_INTEGRITY=warn
# @unit-end:device-integrity
