{
  "sentry": {
    "paths": ["src/app/monitoring"],
    "touchpoints": ["index.js"],
    "packages": ["@sentry/react-native"]
  },
  "splash-animation": {
    "paths": ["src/app/splash"],
    "touchpoints": ["src/app/App.tsx"]
  },
  "biometric-unlock": {
    "paths": ["src/features/biometric-unlock"],
    "touchpoints": [
      "src/app/services/AppServices.tsx",
      "src/app/i18n/index.ts",
      "src/screens/settings/ui/SettingsScreen.tsx",
      "ios/RNFoundation/Info.plist",
      "src/app/App.test.tsx"
    ]
  },
  "carousel": {
    "paths": ["src/shared/ui/Carousel"],
    "touchpoints": ["src/shared/ui/index.ts"]
  },
  "range-slider": {
    "paths": ["src/shared/ui/RangeSlider"],
    "touchpoints": ["src/shared/ui/index.ts"]
  },
  "image-viewer": {
    "paths": ["src/shared/ui/ImageViewer"],
    "touchpoints": ["src/shared/ui/index.ts"]
  },
  "date-time": {
    "paths": ["src/shared/ui/date-time"],
    "touchpoints": ["src/shared/ui/index.ts", "jest.setup.ts"],
    "packages": ["@react-native-community/datetimepicker"]
  },
  "phone-input": {
    "paths": ["src/shared/ui/PhoneInput"],
    "touchpoints": ["src/shared/ui/index.ts"],
    "packages": ["libphonenumber-js"]
  },
  "socket": {
    "paths": [
      "src/shared/api/socket",
      "src/app/services/useRealtime.ts",
      "src/app/services/useRealtime.test.tsx"
    ],
    "touchpoints": [
      "src/shared/api/index.ts",
      "src/app/services/AppServices.tsx"
    ],
    "packages": ["socket.io-client", "socket.io"]
  },
  "media": {
    "paths": ["src/shared/lib/media-picker", "src/features/file-transfer"],
    "touchpoints": [
      "jest.setup.ts",
      "ios/RNFoundation/Info.plist",
      "android/app/src/main/AndroidManifest.xml"
    ],
    "packages": ["react-native-image-crop-picker", "react-native-blob-util"]
  }
}
